# Copie para .env.local (fora do git) e preencha. Na Vercel, cadastre as mesmas
# variáveis em Settings → Environment Variables.

ADMIN_MODO=github            # ou "local": grava direto em content/ e public/, sem commit
GITHUB_TOKEN=                # fine-grained PAT, só este repo, permissão Contents: read and write
GITHUB_OWNER=ThaysaRafaele
GITHUB_REPO=kit-catalogo-jogos
GITHUB_BRANCH=main
ADMIN_SESSAO_SEGREDO=        # string aleatória longa, para assinar o cookie
ADMIN_USUARIOS=              # JSON: [{"usuario":"thay","nome":"Thaysa","hash":"..."}] (gere com npm run admin:senha)
